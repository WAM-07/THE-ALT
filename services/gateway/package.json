{
  "name": "@alt/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "ALT Gateway: the single public entry point. Routing, token checks, rate limits, WebSockets and health.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/http-proxy": "^11.6.4",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  }
}
