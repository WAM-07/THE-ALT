{
  "name": "the-alt-ecosystem",
  "private": true,
  "description": "THE ALT ECOSYSTEM: ALT Core, ALTER, ALTAR and ALTERA in one repository. See ROADMAP.md.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/altar-web",
    "apps/command-centre"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/dev.mjs --demo",
    "migrate": "node scripts/migrate.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "read-pdf": "node scripts/read-pdf.cjs"
  },
  "devDependencies": {
    "@dicebear/collection": "9.4.2",
    "@dicebear/core": "9.4.2",
    "@resvg/resvg-js": "2.6.2",
    "pdf2json": "^4.0.2"
  }
}
