{
  "name": "@alt/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "ALT smart contracts: AITRegistry (AI Identity Tokens) and ALTMarketplace (sales, rentals, royalties).",
  "type": "module",
  "scripts": {
    "build": "hardhat build && node scripts/export-abi.mjs",
    "test": "hardhat test",
    "coverage": "hardhat test --coverage",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^26.6.5",
    "hardhat": "^3.19.0",
    "typescript": "^7.0.2",
    "viem": "^2.57.4"
  },
  "exports": {
    "./abi": {
      "types": "./abi/index.d.ts",
      "default": "./abi/index.js"
    },
    "./deployments/*": "./deployments/*"
  }
}
