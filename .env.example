# The ALT Ecosystem: configuration for every service.
# `npm run dev` copies this file to .env on first run. Development needs NO values filled in:
# blank secrets are generated into .data/dev-secrets.json and a local PostgreSQL is started for you.
# Production must set every secret explicitly.

NODE_ENV=development
LOG_LEVEL=info

# Public base URL of the gateway. Phones on the same Wi-Fi use your PC's LAN IP instead of localhost.
ALT_PUBLIC_URL=http://localhost:8080

# ---------------------------------------------------------------- database
# Blank = embedded PostgreSQL in .data/postgres (no Docker or install needed).
# For Neon/hosted Postgres use the direct (non-pooled) connection string.
DATABASE_URL=
DEV_POSTGRES_PORT=54320

# ---------------------------------------------------------------- ports
GATEWAY_PORT=8080
CORE_PORT=4000
ALTERA_PORT=4100
ALTAR_PORT=4200

# ---------------------------------------------------------------- ALT Core secrets (blank = generated in dev)
# RSA private key (PKCS#8 PEM, newlines as \n) that signs access tokens.
CORE_JWT_PRIVATE_KEY=
# 32 random bytes, base64. Encrypts custodial wallet keys and 2FA secrets.
CORE_ENCRYPTION_KEY=
# Shared by ALT services for /internal calls.
INTERNAL_SERVICE_KEY=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Emails whose accounts become admins at sign-up (comma-separated).
ADMIN_EMAILS=

# ---------------------------------------------------------------- email
# console = print emails (OTP codes) to the log and to GET /core/dev/mail
MAIL_MODE=console
# smtp://user:pass@smtp.example.com:587  (used when MAIL_MODE=smtp)
SMTP_URL=
MAIL_FROM=ALT <no-reply@alt.local>

# ---------------------------------------------------------------- Google sign-in
# OAuth client IDs (web, Android, iOS) whose ID tokens Core accepts, comma-separated.
GOOGLE_CLIENT_IDS=

# Push notifications to closed apps (Firebase Cloud Messaging). A Firebase service-account key:
# the JSON itself, a path to the .json file, or the JSON in base64. Empty = push off (the live
# inbox still works while an app is open). The apps also need their google-services.json.
FCM_SERVICE_ACCOUNT=

# ---------------------------------------------------------------- ALT Command Centre (staff)
# Staff (admin, moderator, support, auditor) must have 2FA on to use the Command Centre's /staff routes.
# Empty = on in production, off in development and the demo.
STAFF_REQUIRE_2FA=
# The key holding the AI registry's GOVERNOR_ROLE, so the Command Centre can suspend AIs on-chain.
# `npm run dev` uses Hardhat's account #0 on the local chain; on Amoy, the deployer's key.
GOVERNOR_PRIVATE_KEY=
# Where Core reaches ALTERA's and ALTAR's APIs to remove content staff decided on (`npm run dev` sets them).
ALTERA_SERVICE_URL=
ALTAR_SERVICE_URL=
# Port of the ALT Command Centre's dev server (the gateway serves it at /command).
COMMAND_PORT=4400

# ---------------------------------------------------------------- web
# Extra browser origins allowed to call the API (ALTAR web is served by the gateway, so it needs none).
CORS_ORIGINS=

# ---------------------------------------------------------------- deep links used by app-to-app handoff
DEEP_LINK_ALTER=alter://handoff
DEEP_LINK_ALTERA=altera://handoff

# ---------------------------------------------------------------- blockchain (Module 17)
# local = a throwaway Hardhat chain on :8545 with freshly deployed contracts (no keys needed)
# amoy  = Polygon Amoy testnet, using packages/contracts/deployments/amoy.json
# off   = no blockchain (AI identity features answer 503)
CHAIN_MODE=local
# For CHAIN_MODE=amoy:
CHAIN_RPC_URL=
# ALT Core's relayer: holds MINTER_ROLE on the AIT registry and pays gas for people.
RELAYER_PRIVATE_KEY=
CHAIN_EXPLORER_URL=https://amoy.polygonscan.com
CHAIN_CONFIRMATIONS=1
# Test POL every new account receives on ALT's own test chain (chain 31337 only, never a public network).
# 0 = off; the beta server uses 100. Without it, the wallet page still offers "Get 100 test POL".
STARTER_TEST_POL=0
# To deploy the contracts to Amoy (once): set AMOY_RPC_URL and AMOY_DEPLOYER_PRIVATE_KEY in your shell,
# then run `npm run deploy:amoy -w @alt/contracts`.

# ---------------------------------------------------------------- IPFS (Module 6)
# local  = content-addressed files under .data (real CIDs, served at /core/ipfs/<cid>)
# pinata = pinned on IPFS through Pinata (create a JWT at https://app.pinata.cloud)
IPFS_MODE=local
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud

# ---------------------------------------------------------------- ALT's ML service (services/ml)
# The toxicity model and sentence embeddings, a Python service on 127.0.0.1:4500 behind INTERNAL_SERVICE_KEY.
# Set it up once with `npm run ml:setup` (Python 3.10+); `npm run dev` then starts it and sets ML_URL itself.
# Blank = moderation uses ALT's rules alone and search uses BM25. Thresholds: ML_TOX_SEVERE, ML_TOX_TOXIC, ML_TOX_MILD.
ML_URL=

# ---------------------------------------------------------------- training (Module 9, the engine)
# Only a trained AI can be verified. simulated = ALT's labelled stand-in (checkpoints, no weights trained;
# the default outside production); trainer = trainings wait for a real trainer at /internal/trainer.
TRAINING_MODE=
TRAINING_SIMULATED_SECONDS=10
# ALT's system check: questions the owner answers themselves, and the readiness to reach (blank = 3 and 50 in production, 0 elsewhere).
CLEARANCE_MIN_EVAL_ITEMS=
CLEARANCE_MIN_READINESS=
# Where trained adapters answer (the inference socket). Blank = trained versions use the base engine.
ADAPTER_INFERENCE_URL=

# ---------------------------------------------------------------- persona engine (LLM providers)
# Tried in order Groq → Gemini → DeepSeek (only those with a key); in development a labelled
# mock answers last so everything works with no keys at all. Override with LLM_PROVIDERS=groq,gemini.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
